    "@orpc/zod": "^1.9.0",
    "@prisma/client": "^6.15.0",
    "@t3-oss/env-core": "^0.13.8",
    "better-auth": "^1.3.13",
    "dotenv": "^17.2.1",
    "hono": "^4.8.2",
    "hono-pino": "^0.10.2",
    "ioredis": "^5.8.0",
    "nodemailer": "^7.0.6",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1",
    "winston": "^3.17.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^7.0.1",
    "prisma": "^6.15.0",
